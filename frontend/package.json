{
  "name": "easy-music-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_USE_MOCK=1 vite",
    "dev:mock-desktop": "VITE_USE_MOCK=1 VITE_MOCK_DESKTOP=1 vite",
